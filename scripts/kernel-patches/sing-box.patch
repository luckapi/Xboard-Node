+++ b/adapter/lifecycle_xboard_test.go
@@ -0,0 +1,39 @@
+package adapter
+
+import (
+	"context"
+	"testing"
+
+	"github.com/sagernet/sing-box/log"
+)
+
+type xboardTestComponent struct{ closes int }
+
+func (c *xboardTestComponent) Start(stage StartStage, scope *Scope) error {
+	if stage == StartStateStart {
+		scope.Add(func() error { c.closes++; return nil })
+	}
+	return nil
+}
+
+func TestXboardDynamicComponentCleanup(t *testing.T) {
+	scope := NewScope(context.Background(), log.NewNOPFactory().NewLogger("test"))
+	for range 10 {
+		component := new(xboardTestComponent)
+		if err := scope.Start("inbound", component, StartStateStart); err != nil {
+			t.Fatal(err)
+		}
+		if err := scope.CloseComponent(component); err != nil {
+			t.Fatal(err)
+		}
+		if component.closes != 1 {
+			t.Fatalf("cleanup calls = %d", component.closes)
+		}
+		if len(scope.children) != 0 || len(scope.cleanups) != 0 {
+			t.Fatal("removed inbound retained lifecycle resources")
+		}
+	}
+	if err := scope.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
