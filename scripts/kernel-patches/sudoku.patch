@@ -0,0 +1,44 @@
+package tunnel
+
+import (
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestEmbeddedMuxQueueLimit(t *testing.T) {
+	stream := newMuxStream(&muxSession{queueLimit: 256 * 1024}, 1)
+	defer func() { stream.abort(io.EOF); _ = stream.Close() }()
+	if err := stream.enqueue(acquireMuxChunk(256 * 1024)); err != nil {
+		t.Fatal(err)
+	}
+	if err := stream.enqueue(acquireMuxChunk(1)); err != errMuxReceiveQueueFull {
+		t.Fatalf("queue cap not enforced: %v", err)
+	}
+}
+
+func TestEmbeddedMuxStreamLimit(t *testing.T) {
+	left, right := net.Pipe()
+	defer left.Close()
+	defer right.Close()
+	done := make(chan error, 1)
+	go func() {
+		done <- HandleMuxStreams(right, func(conn net.Conn, _ string) { var b [1]byte; _, _ = conn.Read(b[:]) })
+	}()
+	client, err := NewMuxClient(left)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	for i := 0; i < 33; i++ {
+		if _, err := client.Dial("example.com:443"); err != nil {
+			break
+		}
+	}
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("mux stream cap not enforced")
+	}
+}
