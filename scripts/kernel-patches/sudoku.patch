@@ -0,0 +1,70 @@
+package sudoku
+
+import (
+	"fmt"
+	"runtime"
+	"slices"
+	"testing"
+)
+
+func TestSharedEncodingMatchesPerKeyReference(t *testing.T) {
+	for _, tc := range []struct{ mode, custom string }{
+		{"prefer_ascii", ""},
+		{"prefer_entropy", ""},
+		{"up_ascii_down_entropy", "xpxvvpvv"},
+	} {
+		var previous *Table
+		for _, key := range []string{"first-key", "second-key"} {
+			table, err := NewTableWithCustom(key, tc.mode, tc.custom)
+			if err != nil {
+				t.Fatal(err)
+			}
+			opposite := table.OppositeDirection()
+			verifyClassicReference(t, table, key)
+			if opposite != table {
+				verifyClassicReference(t, opposite, key)
+			}
+			if previous != nil && (previous.encode != table.encode || previous.OppositeDirection().encode != opposite.encode) {
+				t.Fatal("keys using the same layout must share encoding tables")
+			}
+			previous = table
+		}
+	}
+}
+
+func verifyClassicReference(t *testing.T, table *Table, key string) {
+	t.Helper()
+	grids := shuffledGrids(key)
+	for b, g := range grids[:256] {
+		var ref []uint32
+		for _, pos := range hintPositions {
+			var encoded uint32
+			var hints [4]byte
+			for i, p := range pos {
+				hints[i] = p<<2 | (g[p] - 1)
+				encoded |= uint32(table.layout.hintByte(g[p]-1, p)) << (i * 8)
+			}
+			if got, ok := table.decodeHints(hints[0], hints[1], hints[2], hints[3]); ok && got == byte(b) {
+				ref = append(ref, encoded)
+			}
+		}
+		if len(ref) == 0 || !slices.Equal(ref, table.encode.byGrid[table.encodeRanks[b]]) {
+			t.Fatalf("key %s, layout %s, byte %d: different or empty puzzle sequence", key, table.layout.name, b)
+		}
+	}
+}
+
+func BenchmarkTablePopulation(b *testing.B) {
+	const users = 128
+	for range b.N {
+		tables := make([]*Table, users)
+		for i := range tables {
+			var err error
+			tables[i], err = NewTableWithCustom(fmt.Sprint(i), "prefer_entropy", "")
+			if err != nil {
+				b.Fatal(err)
+			}
+		}
+		runtime.KeepAlive(tables)
+	}
+}
