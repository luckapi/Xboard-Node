new file mode 100644
--- /dev/null
+++ b/apis/xboard.go
@@ -0,0 +1,109 @@
+package apis
+
+import (
+	"encoding/binary"
+	"fmt"
+	"io"
+	"net"
+
+	"github.com/SUDOKU-ASCII/sudoku/internal/config"
+	"github.com/SUDOKU-ASCII/sudoku/internal/protocol"
+	"github.com/SUDOKU-ASCII/sudoku/internal/tunnel"
+	"github.com/SUDOKU-ASCII/sudoku/pkg/connutil"
+	"github.com/SUDOKU-ASCII/sudoku/pkg/obfs/sudoku"
+)
+
+// Credential contains immutable native handshake configuration. It owns no listener.
+type Credential struct {
+	cfg    *config.Config
+	tables []*sudoku.Table
+}
+
+func NewCredential(c Config, aead string) (*Credential, error) {
+	if aead != "aes-128-gcm" && aead != "chacha20-poly1305" {
+		return nil, fmt.Errorf("unsupported Sudoku AEAD")
+	}
+	normalized, err := Normalize(&c)
+	if err != nil {
+		return nil, err
+	}
+	tables, err := BuildTables(&normalized)
+	if err != nil {
+		return nil, err
+	}
+	cfg := &config.Config{Key: normalized.Key, ASCII: normalized.ASCII, AEAD: aead, PaddingMin: normalized.PaddingMin, PaddingMax: normalized.PaddingMax, EnablePureDownlink: normalized.EnablePureDownlink, HTTPMask: config.HTTPMaskConfig{Disable: true}}
+	return &Credential{cfg: cfg, tables: tables}, nil
+}
+
+type Acceptor struct {
+	byTable  map[*sudoku.Table]*config.Config
+	tables   []*sudoku.Table
+	byConfig map[*config.Config]*Credential
+}
+
+func NewAcceptor(credentials []*Credential) *Acceptor {
+	a := &Acceptor{byTable: make(map[*sudoku.Table]*config.Config), byConfig: make(map[*config.Config]*Credential)}
+	for _, c := range credentials {
+		for _, t := range c.tables {
+			a.byTable[t] = c.cfg
+			a.tables = append(a.tables, t)
+		}
+		a.byConfig[c.cfg] = c
+	}
+	return a
+}
+
+// Accept performs the official replay-protected handshake, without opening any target.
+func (a *Acceptor) Accept(raw net.Conn) (net.Conn, *Credential, string, error) {
+	conn, cfg, err := tunnel.SelectCredential(raw, a.byTable, a.tables)
+	if err != nil {
+		return nil, nil, "", err
+	}
+	credential := a.byConfig[cfg]
+	secure, meta, err := tunnel.ServerHandshake(conn, cfg, credential.tables)
+	if err != nil {
+		return nil, nil, "", err
+	}
+	return secure, credential, meta.UserHash, nil
+}
+
+func (c *Credential) Dialer(address string, privateKey []byte) *tunnel.StandardDialer {
+	cfg := *c.cfg
+	cfg.ServerAddress = address
+	return &tunnel.StandardDialer{BaseDialer: tunnel.BaseDialer{Config: &cfg, Tables: c.tables, PrivateKey: privateKey}}
+}
+
+const (
+	OpenTCP   = tunnel.KIPTypeOpenTCP
+	StartMux  = tunnel.KIPTypeStartMux
+	StartUoT  = tunnel.KIPTypeStartUoT
+	KeepAlive = tunnel.KIPTypeKeepAlive
+)
+
+type Message = tunnel.KIPMessage
+
+func HandleMuxStreams(conn net.Conn, handle func(net.Conn, string)) error {
+	return tunnel.HandleMuxStreams(conn, handle)
+}
+
+func ReadMessage(r io.Reader) (*Message, error) { return tunnel.ReadKIPMessage(r) }
+func WriteMessage(w io.Writer, kind byte, data []byte) error {
+	return tunnel.WriteKIPMessage(w, kind, data)
+}
+func DecodeTarget(data []byte) (string, error)         { return protocol.DecodeAddress(data) }
+func ReadDatagram(r io.Reader) (string, []byte, error) { return tunnel.ReadUoTDatagram(r) }
+
+// WriteDatagram is synchronous, so accounting cannot bill dropped queue entries.
+func WriteDatagram(w io.Writer, address string, payload []byte) error {
+	if len(payload) > 65507 {
+		return fmt.Errorf("UDP payload too large")
+	}
+	addr, err := protocol.AppendAddress(nil, address)
+	if err != nil {
+		return err
+	}
+	frame := binary.BigEndian.AppendUint16(nil, uint16(len(addr)))
+	frame = binary.BigEndian.AppendUint16(frame, uint16(len(payload)))
+	frame = append(frame, addr...)
+	return connutil.WriteFull(w, append(frame, payload...))
+}
