--- /dev/null
+++ b/pkg/obfs/sudoku/shared_puzzles.go
@@ -0,0 +1,75 @@
+package sudoku
+
+import "sync"
+
+var canonicalGridRanks = sync.OnceValue(func() map[grid]uint16 {
+	ranks := make(map[grid]uint16, len(allGrids()))
+	for i, g := range allGrids() {
+		ranks[g] = uint16(i)
+	}
+	return ranks
+})
+
+// A hint set is unique among all 288 grids regardless of the user's shuffle.
+// Preserve hintPositions order so that sampling chooses the same wire bytes.
+var canonicalPuzzles = sync.OnceValue(func() [][]uint32 {
+	grids := allGrids()
+	puzzles := make([][]uint32, len(grids))
+	signatures := make([]byte, len(grids))
+	for _, pos := range hintPositions {
+		var seen [256]uint16
+		for i, g := range grids {
+			sig := g[pos[0]] - 1 | (g[pos[1]]-1)<<2 | (g[pos[2]]-1)<<4 | (g[pos[3]]-1)<<6
+			signatures[i] = sig
+			seen[sig]++
+		}
+		for i, sig := range signatures {
+			if seen[sig] == 1 {
+				var hints uint32
+				for j, p := range pos {
+					hints |= uint32(p<<2|((sig>>(2*j))&3)) << (8 * j)
+				}
+				puzzles[i] = append(puzzles[i], hints)
+			}
+		}
+	}
+	return puzzles
+})
+
+type layoutPuzzles struct {
+	byGrid [][]uint32
+}
+
+var layoutPuzzleCache = struct {
+	sync.Mutex
+	sets map[[4][16]byte]*layoutPuzzles
+}{sets: make(map[[4][16]byte]*layoutPuzzles)}
+
+func sharedLayoutPuzzles(layout *byteLayout) *layoutPuzzles {
+	layoutPuzzleCache.Lock()
+	defer layoutPuzzleCache.Unlock()
+	if set := layoutPuzzleCache.sets[layout.encodeHint]; set != nil {
+		return set
+	}
+
+	canonical := canonicalPuzzles()
+	byGrid := make([][]uint32, len(canonical))
+	var wire [64]uint32
+	for i := range wire {
+		wire[i] = uint32(layout.hintByte(byte(i&3), byte(i>>2)))
+	}
+	for i, puzzles := range canonical {
+		packed := make([]uint32, len(puzzles))
+		for j, p := range puzzles {
+			packed[j] = wire[p&63] | wire[p>>8&63]<<8 | wire[p>>16&63]<<16 | wire[p>>24&63]<<24
+		}
+		byGrid[i] = packed
+	}
+	set := &layoutPuzzles{byGrid: byGrid}
+	// Active tables keep their references. Bound retained inactive custom layouts.
+	if len(layoutPuzzleCache.sets) >= 8 {
+		clear(layoutPuzzleCache.sets)
+	}
+	layoutPuzzleCache.sets[layout.encodeHint] = set
+	return set
+}
