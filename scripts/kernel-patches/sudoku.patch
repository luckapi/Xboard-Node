+++ b/internal/tunnel/xboard.go
@@ -0,0 +1,51 @@
+package tunnel
+
+import (
+	"bufio"
+	"fmt"
+	"io"
+	"net"
+
+	"github.com/SUDOKU-ASCII/sudoku/internal/config"
+	"github.com/SUDOKU-ASCII/sudoku/pkg/obfs/sudoku"
+)
+
+// SelectCredential reuses the native bounded probe for independently keyed users.
+func SelectCredential(raw net.Conn, configs map[*sudoku.Table]*config.Config, tables []*sudoku.Table) (net.Conn, *config.Config, error) {
+	selected, prefix, err := SelectHandshakeObfsByProbe(bufio.NewReader(raw), tables, func(p []byte, t *sudoku.Table, mode obfsUplinkMode) error {
+		if len(p) == 0 {
+			return io.EOF
+		}
+		return probeHandshakeBytes(p, configs[t], t, mode)
+	})
+	if err != nil {
+		return nil, nil, err
+	}
+	return NewPreBufferedConn(raw, prefix), configs[selected.Table], nil
+}
+
+// HandleMuxStreams hands decoded native streams to the embedding router, without
+// an intermediate dial/pipe that would hide application bytes from sniffing.
+func HandleMuxStreams(conn net.Conn, handle func(net.Conn, string)) error {
+	if conn == nil || handle == nil {
+		return fmt.Errorf("nil mux connection or handler")
+	}
+	session := newMuxSessionWithLimits(conn, func(stream *muxStream, payload []byte) {
+		target, err := decodeMuxOpenTarget(payload)
+		if err != nil {
+			stream.session.sendReset(stream.id, "bad address")
+			stream.abort(err)
+			stream.session.removeStream(stream.id)
+			return
+		}
+		defer stream.Close()
+		handle(stream, target)
+	}, 256*1024, 32)
+	session.startKeepalive(muxKeepaliveInterval, muxKeepaliveIdle)
+	<-session.closed
+	err := session.closedErr()
+	if isExpectedMuxSessionClose(err) {
+		return nil
+	}
+	return err
+}
