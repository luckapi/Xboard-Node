diff --git a/dgram/xboard_budget_test.go b/dgram/xboard_budget_test.go
new file mode 100644
index 0000000..63a110a
--- /dev/null
+++ b/dgram/xboard_budget_test.go
@@ -0,0 +1,38 @@
+package dgram
+
+import (
+	"sync"
+	"testing"
+)
+
+func TestXboardQueueByteBudgetAndClose(t *testing.T) {
+	router := NewRouter(nil, 8)
+	first, second := router.Register(1), router.Register(2)
+	router.deliver(1, make([]byte, 6))
+	router.deliver(2, make([]byte, 3))
+	if len(second.C) != 0 || router.queuedBytes.Load() != 6 {
+		t.Fatal("session queue budget exceeded")
+	}
+	first.ReleasePacket(<-first.C)
+	router.deliver(2, nil)
+	if router.queuedBytes.Load() != 1 {
+		t.Fatal("empty UDP packet must reserve one budget unit")
+	}
+	second.Close()
+	if router.queuedBytes.Load() != 0 {
+		t.Fatal("closing a flow leaked queue reservations")
+	}
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 100; i++ {
+			router.deliver(1, []byte{1})
+		}
+	}()
+	go func() { defer wg.Done(); first.Close() }()
+	wg.Wait()
+	if router.queuedBytes.Load() != 0 {
+		t.Fatal("concurrent delivery and close leaked reservations")
+	}
+}
